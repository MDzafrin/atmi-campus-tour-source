generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Reservation {
  id            String    @id @default(cuid())
  code          String    @unique
  verifyToken   String    @unique @default(cuid())
  tourType      String
  programName   String    @default("")
  participants  Int
  date          String
  timeSlot      String
  name          String
  institution   String
  email         String
  phone         String
  notes         String?
  companionId   String?
  companionName String    @default("")
  status        String    @default("PENDING")
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model TourProgram {
  id           String      @id @default(cuid())
  slug         String      @unique
  sortOrder    Int         @default(0)
  active       Boolean     @default(true)
  highlight    Boolean     @default(false)
  nameId       String
  nameEn       String
  descId       String
  descEn       String
  includesId   String      @default("")
  includesEn   String      @default("")
  durationMin  Int         @default(150)
  capacityMax  Int         @default(30)
  imageUrl     String      @default("")
  departmentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model Department {
  id        String        @id @default(cuid())
  name      String        @unique
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  members   Companion[]
  programs  TourProgram[]
}

model Companion {
  id           String     @id @default(cuid())
  departmentId String
  name         String
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

model SiteSetting {
  id              Int      @id @default(1)
  minParticipants Int      @default(10)
  maxParticipants Int      @default(30)
  durationMinutes Int      @default(150)
  timeSlots       String   @default("09:00-11:00,13:30-15:30")
  openDates       String   @default("")
  updatedAt       DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  bodyHtml  String
  status    String   @default("QUEUED")
  error     String?
  createdAt DateTime @default(now())
}
