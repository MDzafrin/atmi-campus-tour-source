# Alamat aplikasi web. Untuk uji coba di laptop: http://localhost:3000
# Setelah situs online: https://domain-situs-anda
WA_APP_URL=http://localhost:3000

# Kunci rahasia, HARUS sama persis dengan WA_WORKER_SECRET di aplikasi web.
# Buat string acak panjang (minimal 16 karakter), jangan dibagikan.
WA_WORKER_SECRET=ISI DENGAN STRING ACAK PANJANG (MINIMAL 16 KARAKTER)

# Cek antrean setiap berapa detik
WA_POLL_SECONDS=10

# Jeda acak antar pesan (detik). Jeda ini penting supaya nomor tidak dianggap bot.
WA_MIN_DELAY_SECONDS=5
WA_MAX_DELAY_SECONDS=15

# Batas maksimal pesan per hari
WA_DAILY_CAP=100

# Nomor yang DILARANG dipakai sebagai pengirim (pisahkan dengan koma, format 62...).
# Kalau QR dipindai dengan salah satu nomor ini, worker langsung berhenti.
WA_BLOCKED_NUMBERS=6281288331700
