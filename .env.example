# ---------- Database (Supabase) ----------
# Runtime aplikasi: Transaction pooler, port 6543, wajib ?pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI (db push / migrate): Session pooler, port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- URL publik website ----------
APP_URL=http://localhost:3000

# ---------- Dashboard admin ----------
ADMIN_PASSWORD=ganti-dengan-password-kuat

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Notifikasi admin ----------
ADMIN_EMAIL=

# ---------- Kotak masuk demo (jam) ----------
KOTAK_MASUK_TAMPIL_JAM=48
